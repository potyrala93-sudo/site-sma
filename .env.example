# Copie este arquivo para ".env" e preencha a sua chave da API do Claude.
# Crie a chave em https://platform.claude.com (Settings > API Keys).
# Nunca compartilhe o arquivo .env nem publique a chave no site.
ANTHROPIC_API_KEY=

# Opcional
# PORT=3000
# FOLHITO_MODELO=claude-opus-5-5

# Compras (seção Custos): chave SECRETA do Supabase do App de Compras
# (Supabase › Project Settings › API Keys › secret / service_role). Fica só no servidor.
COMPRAS_SUPABASE_KEY=
